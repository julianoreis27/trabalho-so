# Porta HTTP da aplicação (no Cloud Run ela é definida automaticamente)
PORT=3000

# Cria a tabela automaticamente na inicialização (true/false)
AUTO_CREATE_TABLE=true

# PostgreSQL local (docker compose up -d)
DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque

# No Cloud Run com Cloud SQL, a conexão é feita por socket Unix:
# DATABASE_URL=postgresql://USUARIO:SENHA@/BANCO?host=/cloudsql/PROJETO:REGIAO:INSTANCIA

# Use "true" para conexões TCP que exigem SSL
# DATABASE_SSL=true
