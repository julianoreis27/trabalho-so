# Porta HTTP da aplicação
PORT=3000

# Banco de dados: "dynamodb" ou "postgres"
DB_CLIENT=dynamodb

# Cria a tabela automaticamente na inicialização (true/false)
AUTO_CREATE_TABLE=true

# ---------- DynamoDB ----------
AWS_REGION=us-east-1
DYNAMODB_TABLE=Produtos
# DynamoDB Local (docker compose up -d dynamodb)
DYNAMODB_ENDPOINT=http://localhost:8000
# Para o DynamoDB Local, qualquer valor serve.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------- PostgreSQL ----------
# DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque
# DATABASE_SSL=true
